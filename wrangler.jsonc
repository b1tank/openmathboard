{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openmathboard",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "lezhi.school", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  }
}
